
@model FoodShare.Models.Donation

@{
    ViewData["Title"] = "Delete Donation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <span class="text-danger fw-bold">CONFIRM DELETION</span>
                    <h1 class="fw-bold mt-2">Delete this donation?</h1>

                    <p class="text-muted">
                        This action permanently removes the donation record.
                        Please confirm before continuing.
                    </p>

                    <hr />

                    <h4>@Model.Title</h4>
                    <p><strong>Food type:</strong> @Model.FoodType</p>
                    <p><strong>Quantity:</strong> @Model.Quantity</p>
                    <p><strong>Donor:</strong> @Model.DonorName</p>
                    <p><strong>Status:</strong> @Model.Status</p>

                    <form asp-action="Delete" asp-route-id="@Model.Id"
                          method="post" class="mt-4">
                        <button type="submit" class="btn btn-danger w-100">
                            Yes, Delete Donation
                        </button>
                    </form>

                    <a asp-action="Details" asp-route-id="@Model.Id"
                       class="btn btn-light w-100 mt-2">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
