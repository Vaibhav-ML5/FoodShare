
@model IEnumerable<FoodShare.Models.Donation>

@{
    ViewData["Title"] = "FoodShare Dashboard";
}

<div class="container py-5">
    <span class="text-success fw-bold">FOODSHARE ADMIN</span>
    <h1 class="fw-bold mt-2">Dashboard</h1>
    <p class="text-muted">A snapshot of community food donations.</p>

    <div class="row g-3 my-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Total donations</p>
                    <h2 class="fw-bold">@ViewBag.TotalDonations</h2>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Available</p>
                    <h2 class="fw-bold text-success">
                        @ViewBag.AvailableDonations
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Claimed</p>
                    <h2 class="fw-bold text-primary">
                        @ViewBag.ClaimedDonations
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Completed</p>
                    <h2 class="fw-bold text-secondary">
                        @ViewBag.CompletedDonations
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
        <h3 class="fw-bold">Recent donations</h3>
        <a asp-action="Index" class="btn btn-outline-success">
            View all
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Food</th>
                    <th>Quantity</th>
                    <th>Donor</th>
                    <th>Status</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var donation in Model)
                {
                    <tr>
                        <td>@donation.Title</td>
                        <td>@donation.Quantity</td>
                        <td>@donation.DonorName</td>
                        <td>
                            <span class="badge bg-light text-dark">
                                @donation.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@donation.Id"
                               class="btn btn-sm btn-outline-success">
                                Open
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
