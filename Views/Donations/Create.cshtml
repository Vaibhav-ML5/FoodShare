
@model FoodShare.Models.Donation

@{
    ViewData["Title"] = "Donate Food";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <span class="text-success fw-bold">FOODSHARE COMMUNITY</span>
                <h1 class="fw-bold mt-2">Share food, spread hope.</h1>
                <p class="text-muted">
                    Enter the details below to share surplus food with your community.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Food title</label>
                            <input asp-for="Title" class="form-control"
                                   placeholder="e.g. Fresh vegetable meals" />
                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FoodType" class="form-label">Food type</label>
                            <select asp-for="FoodType" class="form-select">
                                <option value="">Select food type</option>
                                <option>Cooked Meals</option>
                                <option>Fruits</option>
                                <option>Vegetables</option>
                                <option>Bakery</option>
                                <option>Packaged Food</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="FoodType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label">
                                Quantity (servings or units)
                            </label>
                            <input asp-for="Quantity" type="number"
                                   min="1" class="form-control"
                                   placeholder="e.g. 25" />
                            <span asp-validation-for="Quantity"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PickupLocation" class="form-label">
                                Pickup location
                            </label>
                            <input asp-for="PickupLocation" class="form-control"
                                   placeholder="Enter the full pickup address" />
                            <span asp-validation-for="PickupLocation"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DonorName" class="form-label">
                                    Donor name
                                </label>
                                <input asp-for="DonorName" class="form-control" />
                                <span asp-validation-for="DonorName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ContactNumber" class="form-label">
                                    Contact number
                                </label>
                                <input asp-for="ContactNumber" type="tel"
                                       class="form-control" />
                                <span asp-validation-for="ContactNumber"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PickupDeadline" class="form-label">
                                Pickup deadline
                            </label>
                            <input asp-for="PickupDeadline" type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="PickupDeadline"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">
                                Additional details (optional)
                            </label>
                            <textarea asp-for="Description" rows="3"
                                      class="form-control"
                                      placeholder="Describe the food and any pickup instructions"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            Submit Donation
                        </button>

                        <a asp-action="Index"
                           class="btn btn-light w-100 mt-2">
                            View Available Donations
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
